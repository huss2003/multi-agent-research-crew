# Copy to .env. Nothing here is required when DEMO_MODE=1.
DEMO_MODE=0
ANTHROPIC_API_KEY=
CREW_MODEL=claude-sonnet-5-5

# Search provider: tavily | brave | serpapi
CREW_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# Budget (global, across all agents)
CREW_BUDGET_TOKENS=200000
CREW_BUDGET_USD=

# Where JSONL traces are written
CREW_TRACE_DIR=.crew/runs
